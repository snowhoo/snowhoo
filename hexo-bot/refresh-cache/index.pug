extends includes/layout.pug

block home-widgets
  #custom-widgets
    // 节日节气
    include FestivalSolar.pug
    //- 新七彩按钮（展开式）
    #seven-color-card(style="display:none")
      .sc-btn-row
        each item in [0,1,2,3]
          button.sc-btn.sc-btn-placeholder(disabled style="visibility:hidden")
    // 诗词
    include DailyPoetry.pug
    // 历史上的今天
    include HistoryToday.pug
    //include ArticleListHaed.pug

block content
  #post-list-collapse
    #post-list-collapse-bar
      i.fas.fa-chevron-down.collapse-icon
      span.collapse-text 展开文章列表
      i.fas.fa-chevron-down.collapse-icon
    #post-list-container
      include ./includes/mixins/indexPostUI.pug
      +indexPostUI

  script.
    (function() {
      var STORAGE_KEY = 'postListCollapsed';
      var bar = document.getElementById('post-list-collapse-bar');
      var container = document.getElementById('post-list-container');
      var text = bar.querySelector('.collapse-text');
      var icons = bar.querySelectorAll('.collapse-icon');

      function setCollapsed(collapsed) {
        if (collapsed) {
          container.classList.add('collapsed');
          text.textContent = '展开文章列表';
          icons.forEach(function(icon) {
            icon.style.transform = 'rotate(0deg)';
          });
        } else {
          container.classList.remove('collapsed');
          text.textContent = '收起文章列表';
          icons.forEach(function(icon) {
            icon.style.transform = 'rotate(180deg)';
          });
        }
        try {
          localStorage.setItem(STORAGE_KEY, collapsed ? 'true' : 'false');
        } catch(e) {}
      }

      try {
        var saved = localStorage.getItem(STORAGE_KEY);
        if (saved === 'false') {
          setCollapsed(false);
        } else {
          setCollapsed(true);
        }
      } catch(e) {
        setCollapsed(true);
      }

      bar.addEventListener('click', function() {
        var isCollapsed = container.classList.contains('collapsed');
        setCollapsed(!isCollapsed);
      });
    })();
