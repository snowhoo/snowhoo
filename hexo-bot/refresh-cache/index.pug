extends includes/layout.pug

block home-widgets
  #custom-widgets
    // 节日节气
    include FestivalSolar.pug
    //- 新七彩按钮（展开式）
    #seven-color-card(style="display:none")
      .sc-btn-row
        each item in [0,1,2,3]
          button.sc-btn.sc-btn-placeholder(disabled style="visibility:hidden")
    // 诗词
    include DailyPoetry.pug
    // 历史上的今天
    include HistoryToday.pug
    //include ArticleListHaed.pug

block content
  #post-list-collapse
    #post-list-collapse-bar
      i.fas.fa-chevron-down.collapse-icon
      span.collapse-text 展开文章列表
      i.fas.fa-chevron-down.collapse-icon
    // 用 template 标签存放文章列表，默认不渲染
    template#post-list-template
      include ./includes/mixins/indexPostUI.pug
      +indexPostUI
