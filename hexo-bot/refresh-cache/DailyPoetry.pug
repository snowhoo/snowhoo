#poetry-widget(style="display:none")
  .poetry-container
    .poem-main
      .verse#verseLine
      .meta-wrapper
        .meta-row
          span.author#authorName
          span.dynasty#dynastyText
          span.title#originText
        .expand-control#expandToggle
          span.arrow#arrowIcon ▼
          span
    .detail-panel#detailPanel
      .detail-inner
        .full-poem#fullPoemContent
        .poet-bio#poetBio
  script.
    (function(){
      var current = {line:'',author:'',dynasty:'',title:'',fullDetail:null};

      function updateDetail() {
        var fd = document.getElementById('fullPoemContent');
        var pb = document.getElementById('poetBio');
        if (current.fullDetail) {
          fd.innerText = current.fullDetail.fullText;
          current.fullBio = current.fullDetail.poetBio;
          renderBio();
        } else {
          fd.innerText = '「' + current.line + '」';
          current.fullBio = current.author + '，生平逸事待考。';
          renderBio();
        }
      }

      function renderBio() {
        var pb = document.getElementById('poetBio');
        if (current.fullBio.length > 100) {
          pb.innerText = current.fullBio.substring(0, 100) + '…';
          pb.classList.add('bio-truncated');
        } else {
          pb.innerText = current.fullBio;
          pb.classList.remove('bio-truncated');
        }
      }

      function toggleBio() {
        var pb = document.getElementById('poetBio');
        if (pb.classList.contains('bio-expanded')) {
          pb.innerText = current.fullBio.substring(0, 100) + '…';
          pb.classList.remove('bio-expanded');
          pb.classList.add('bio-truncated');
        } else {
          pb.innerText = current.fullBio;
          pb.classList.remove('bio-truncated');
          pb.classList.add('bio-expanded');
        }
      }

      function toggleDetail() {
        var panel = document.getElementById('detailPanel');
        var arrow = document.getElementById('arrowIcon');
        var isOpen = panel.style.display === 'block';
        if (isOpen) {
          panel.style.display = 'none';
          arrow.innerHTML = '▼';
        } else {
          updateDetail();
          panel.style.display = 'block';
          arrow.innerHTML = '▲';
        }
      }

      function renderPoem(poem) {
        document.getElementById('verseLine').innerText = poem.line;
        document.getElementById('authorName').innerText = poem.author;
        document.getElementById('dynastyText').innerText = poem.dynasty;
        document.getElementById('originText').innerText = '《' + poem.title + '》';
        current.line = poem.line;
        current.author = poem.author;
        current.dynasty = poem.dynasty;
        current.title = poem.title;
        if (poem.detail && poem.detail.content) {
          var content = Array.isArray(poem.detail.content)
            ? poem.detail.content.join('\n')
            : poem.detail.content;
          current.fullDetail = {
            fullText: content,
            poetBio: poem.detail.biography || poem.author + '，生平逸事待考。'
          };
        }
      }

      // 读取本地 DailyPoetry.json（同源，无 CORS），3秒超时
      async function loadPoetry() {
        try {
          var controller = new AbortController();
          var tid = setTimeout(function() { controller.abort(); }, 3000);
          var r = await fetch('/js/DailyPoetry.json', { signal: controller.signal });
          clearTimeout(tid);
          if (r.ok) {
            var j = await r.json();
            if (j && j.line) { renderPoem(j); document.getElementById('poetry-widget').style.display = ''; return; }
          }
        } catch(e){}
        // 加载失败，不显示
      }

      document.addEventListener('DOMContentLoaded', function() {
        loadPoetry();
        document.getElementById('expandToggle').addEventListener('click', toggleDetail);
        document.getElementById('poetBio').addEventListener('click', toggleBio);
      });
    })();
