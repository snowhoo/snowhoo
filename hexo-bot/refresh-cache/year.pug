- var yrNow = new Date()
- var yrYear = yrNow.getFullYear()
- var yrStart = new Date(yrYear, 0, 0)
- var yrDiff = yrNow - yrStart
- var yrOneDay = 1000 * 60 * 60 * 24
- var yrDayOfYear = Math.floor(yrDiff / yrOneDay)
- var yrTotalDays = (yrYear % 400 === 0 || (yrYear % 4 === 0 && yrYear % 100 !== 0)) ? 366 : 365
- var yrPct = Math.min(yrDayOfYear / yrTotalDays, 1)
- var yrTotalBlocks = 12
- var yrFilled = Math.round(yrPct * yrTotalBlocks)
- var yrBar = ''
- var yrI = 0
- while (yrI < yrTotalBlocks) { yrBar += yrI < yrFilled ? '█' : '░'; yrI++ }

.year-progress-wrap
  span.year-progress= yrYear + ' 进度条 ' + yrBar