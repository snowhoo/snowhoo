- var now = new Date()
- var year = now.getFullYear()
- var start = new Date(year, 0, 0)
- var diff = now - start
- var oneDay = 1000 * 60 * 60 * 24
- var dayOfYear = Math.floor(diff / oneDay)
- var totalDays = (year % 400 === 0 || (year % 4 === 0 && year % 100 !== 0)) ? 366 : 365
- var pct = Math.min(dayOfYear / totalDays, 1)
- var totalBlocks = 12
- var filled = Math.round(pct * totalBlocks)
- var bar = ''
- var i = 0
- while (i < filled) { bar += '■'; i++ }
- while (i < totalBlocks) { bar += '□'; i++ }

span.year-progress= year + '进度条：' + bar